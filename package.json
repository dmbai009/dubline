{
  "name": "dubline",
  "version": "1.4.0",
  "description": "Collaborative voice dubbing on a timeline",
  "main": "electron-main.js",
  "author": "dmbai009",
  "license": "MIT",
  "engines": {
    "node": ">=20.1"
  },
  "scripts": {
    "start": "electron .",
    "start:server": "node server.js",
    "prepare:icons": "node tools/build-icons.js",
    "prepare:cloudflared": "node tools/download-cloudflared.js",
    "dist": "npm run prepare:icons && npm run prepare:cloudflared && electron-builder --win portable --x64",
    "test:electron": "node tools/electron-smoke.js",
    "test:electron:editor": "node tools/electron-editor-smoke.js",
    "test:electron:guest": "node tools/electron-guest-smoke.js",
    "test:electron:cloudflare": "node tools/electron-smoke.js cloudflare",
    "test": "node --test",
    "test:e2e": "node --test --test-concurrency=1 e2e/launcher.e2e.js e2e/desktop.e2e.js e2e/studio.e2e.js e2e/room.e2e.js e2e/media.e2e.js e2e/security.e2e.js e2e/workflow.e2e.js e2e/reliability.e2e.js e2e/audit-fixes.e2e.js e2e/projects.e2e.js e2e/workflow14.e2e.js e2e/direct-media.e2e.js e2e/solo-feedback.e2e.js e2e/proxy.e2e.js e2e/take-mix.e2e.js",
    "check": "node tools/check.js",
    "test:electron:take-mix": "node tools/electron-take-mix-smoke.js",
    "test:electron:storage": "node tools/electron-storage-smoke.js",
    "test:electron:projects": "node tools/electron-project-smoke.js",
    "test:electron:portable": "node tools/electron-portable-smoke.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "mediabunny": "^1.60.0",
    "multer": "^2.4.0",
    "socket.io": "^4.7.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron@44.5.0": true
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.12.0",
    "socket.io-client": "^4.8.4"
  },
  "build": {
    "appId": "io.github.dmbai009.dubline",
    "productName": "Dubline",
    "asar": true,
    "portable": {
      "unpackDirName": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "electron-storage.js",
      "electron-network.js",
      "electron-update.js",
      "electron-external-links.js",
      "electron-preload.js",
      "electron-guest-preload.js",
      "electron-launcher-preload.js",
      "electron-launcher.js",
      "electron-launcher.html",
      "server.js",
      "server/**/*",
      "public/**/*",
      "!public/uploads/**/*",
      "!public/packs/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "resources/cloudflared.exe",
        "to": "bin/cloudflared.exe"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dubline.exe"
    }
  }
}
